// Сторінка налаштувань: джерело тривоги, звук, оформлення.

import { ScrollView } from "std-widgets.slint";
import { Theme, Shape, Type, Motion, Icons } from "../theme.slint";
import { AppState } from "../state.slint";
import { Card, CardKind, SectionHeader, SettingRow, Divider } from "../components/surfaces.slint";
import { Button, ButtonKind, IconButton, ButtonGroup } from "../components/buttons.slint";
import { Switch, Slider, TextField, Stepper } from "../components/inputs.slint";
import { Dropdown } from "../components/dropdown.slint";

// Поле шляху до власного звуку з кнопкою прослуховування.
component SoundFileRow {
    in property <string> label;
    in property <string> path;
    in property <int> sound;
    in property <string> placeholder: @tr("Вбудований звук");
    callback edited(string);

    min-height: 56px;

    HorizontalLayout {
        spacing: 8px;

        TextField {
            horizontal-stretch: 1;
            label: label;
            placeholder: placeholder;
            text: path;
            container-color: Theme.surface-container;
            edited(text) => { root.edited(text); }
        }
        VerticalLayout {
            alignment: center;

            IconButton {
                icon: Icons.play;
                kind: tonal;
                tooltip: @tr("Прослухати");
                clicked => { AppState.preview-sound(sound); }
            }
        }
    }
}

export component SettingsPage {
    in property <bool> narrow: false;

    ScrollView {
        width: root.width;
        height: root.height;
        content-width: self.visible-width;

        VerticalLayout {
            padding: narrow ? 16px : 24px;
            padding-bottom: 112px;
            spacing: 16px;
            alignment: start;

            Text {
                text: @tr("Налаштування");
                color: Theme.on-surface;
                font-size: Type.headline-large;
                font-weight: Type.heavy;
            }

            // Повітряна тривога.
            Card {
                kind: CardKind.filled;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    SectionHeader {
                        text: @tr("Повітряна тривога");
                        subtitle: @tr("Джерело даних і поведінка під час тривоги");
                        icon: Icons.siren;
                    }

                    SettingRow {
                        title: @tr("Стежити за тривогою");
                        description: @tr("Періодично опитувати API і подавати сирену");

                        Switch {
                            checked: AppState.settings.alert-enabled;
                            toggled(value) => {
                                AppState.settings.alert-enabled = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    Divider { }

                    Text {
                        text: @tr("Джерело даних");
                        color: Theme.on-surface-variant;
                        font-size: Type.label-large;
                        font-weight: Type.medium;
                    }
                    HorizontalLayout {
                        alignment: start;

                        ButtonGroup {
                            items: [
                                { label: "alerts.in.ua", icon: Icons.key },
                                { label: @tr("Ubilling (без токена)"), icon: Icons.public },
                            ];
                            selected: AppState.settings.provider;
                            selected-changed(index) => {
                                AppState.settings.provider = index;
                                AppState.settings-changed();
                            }
                        }
                    }

                    if AppState.settings.provider == 0: TextField {
                        label: @tr("Токен API alerts.in.ua");
                        placeholder: @tr("Вставте токен");
                        supporting-text: @tr("Отримати токен можна на devs.alerts.in.ua");
                        password: true;
                        leading-icon: Icons.key;
                        text: AppState.settings.token;
                        container-color: Theme.surface-container;
                        edited(text) => {
                            AppState.settings.token = text;
                            AppState.settings-changed();
                        }
                    }

                    Rectangle { height: 4px; }

                    Dropdown {
                        label: @tr("Область");
                        model: AppState.regions;
                        current-index: AppState.settings.region;
                        leading-icon: Icons.location;
                        container-color: Theme.surface-container;
                        selected(index) => {
                            if index != AppState.settings.region {
                                AppState.settings.region = index;
                                AppState.settings.district = 0;
                                AppState.settings-changed();
                            }
                        }
                    }

                    // Тривогу по району повертає лише alerts.in.ua.
                    if AppState.settings.provider == 0 && AppState.districts.length > 1: Dropdown {
                        label: @tr("Район");
                        model: AppState.districts;
                        current-index: AppState.settings.district;
                        leading-icon: Icons.location;
                        container-color: Theme.surface-container;
                        selected(index) => {
                            AppState.settings.district = index;
                            AppState.settings-changed();
                        }
                    }

                    SettingRow {
                        title: @tr("Інтервал опитування");
                        description: @tr("Як часто перевіряти стан тривоги");

                        Stepper {
                            value: AppState.settings.poll-seconds;
                            minimum: 10;
                            maximum: 600;
                            step: 5;
                            suffix: @tr("с");
                            changed(value) => {
                                AppState.settings.poll-seconds = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: @tr("Вимикати дзвінки під час тривоги");
                        description: @tr("Шкільні дзвінки не подаються до відбою");

                        Switch {
                            checked: AppState.settings.mute-bells;
                            toggled(value) => {
                                AppState.settings.mute-bells = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    SettingRow {
                        title: @tr("Часткова тривога — це тривога");
                        description: @tr("Реагувати, якщо тривогу оголошено лише в частині громад області чи району");

                        Switch {
                            checked: AppState.settings.partial-is-alert;
                            toggled(value) => {
                                AppState.settings.partial-is-alert = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    // Рівні тривоги розрізняє лише alerts.in.ua.
                    if AppState.settings.provider == 0: VerticalLayout {
                        spacing: 12px;

                        Divider { }
                        Text {
                            text: @tr("Тривога жовтого рівня");
                            color: Theme.on-surface-variant;
                            font-size: Type.label-large;
                            font-weight: Type.medium;
                        }
                        Text {
                            text: AppState.settings.yellow-mode == 0
                                ? @tr("Лише показується на головній: без сирени, дзвінки подаються")
                                : AppState.settings.yellow-mode == 1
                                ? @tr("Як тривога червоного рівня: та сама сирена і той самий відбій")
                                : @tr("Як тривога червоного рівня, але з власними сигналами початку і відбою");
                            color: Theme.on-surface-variant;
                            font-size: Type.body-medium;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;

                            ButtonGroup {
                                items: [
                                    { label: @tr("Не реагувати"), icon: Icons.info },
                                    { label: @tr("Як червоного рівня"), icon: Icons.siren },
                                    { label: @tr("Окремі звуки"), icon: Icons.sound },
                                ];
                                selected: AppState.settings.yellow-mode;
                                selected-changed(index) => {
                                    AppState.settings.yellow-mode = index;
                                    AppState.settings-changed();
                                }
                            }
                        }
                        if AppState.settings.yellow-mode == 2: SoundFileRow {
                            label: @tr("Сигнал тривоги жовтого рівня");
                            placeholder: @tr("Вбудований сигнал «ті-ту»");
                            path: AppState.settings.yellow-siren-file;
                            sound: 5;
                            edited(text) => {
                                AppState.settings.yellow-siren-file = text;
                                AppState.settings-changed();
                            }
                        }
                        if AppState.settings.yellow-mode == 2: SoundFileRow {
                            label: @tr("Відбій тривоги жовтого рівня");
                            placeholder: @tr("Вбудований передзвін відбою");
                            path: AppState.settings.yellow-all-clear-file;
                            sound: 6;
                            edited(text) => {
                                AppState.settings.yellow-all-clear-file = text;
                                AppState.settings-changed();
                            }
                        }
                        Divider { }
                    }

                    SettingRow {
                        title: @tr("Сигнал відбою");
                        description: @tr("Подавати передзвін після завершення тривоги");

                        Switch {
                            checked: AppState.settings.play-all-clear;
                            toggled(value) => {
                                AppState.settings.play-all-clear = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                }
            }

            // Хвилина мовчання і гімн.
            Card {
                kind: CardKind.filled;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    SectionHeader {
                        text: @tr("Хвилина мовчання");
                        subtitle: @tr("Щоденне вшанування загиблих, після нього — державний гімн");
                        icon: Icons.flag;
                    }

                    SettingRow {
                        title: @tr("Подавати хвилину мовчання");
                        description: @tr("Метроном протягом хвилини або власна доріжка");

                        Switch {
                            checked: AppState.settings.memorial-enabled;
                            toggled(value) => {
                                AppState.settings.memorial-enabled = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    SettingRow {
                        title: @tr("Час");
                        description: @tr("Загальнонаціональна хвилина мовчання — о 09:00");

                        TextField {
                            width: 112px;
                            label: @tr("ГГ:ХХ");
                            centered: true;
                            text: AppState.settings.memorial-time;
                            error: !AppState.memorial-time-valid;
                            container-color: Theme.surface-container;
                            edited(text) => {
                                AppState.settings.memorial-time = text;
                                AppState.settings-changed();
                            }
                        }
                    }
                    SettingRow {
                        title: @tr("Лише в навчальні дні");
                        description: @tr("Інакше — щодня, включно з вихідними");

                        Switch {
                            checked: AppState.settings.memorial-school-days;
                            toggled(value) => {
                                AppState.settings.memorial-school-days = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    SettingRow {
                        title: @tr("Гімн після хвилини мовчання");
                        description: AppState.settings.anthem-file == ""
                            ? @tr("Вкажіть файл гімну нижче, інакше гімн не прозвучить")
                            : @tr("Звучить одразу після хвилини мовчання");

                        Switch {
                            checked: AppState.settings.memorial-anthem;
                            toggled(value) => {
                                AppState.settings.memorial-anthem = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    Divider { }

                    Rectangle { height: 4px; }

                    SoundFileRow {
                        label: @tr("Доріжка хвилини мовчання");
                        path: AppState.settings.silence-file;
                        sound: 3;
                        edited(text) => {
                            AppState.settings.silence-file = text;
                            AppState.settings-changed();
                        }
                    }
                    SoundFileRow {
                        label: @tr("Доріжка гімну");
                        placeholder: @tr("Файл не вибрано");
                        path: AppState.settings.anthem-file;
                        sound: 4;
                        edited(text) => {
                            AppState.settings.anthem-file = text;
                            AppState.settings-changed();
                        }
                    }
                }
            }

            // Звук.
            Card {
                kind: CardKind.filled;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    SectionHeader {
                        text: @tr("Звук");
                        subtitle: @tr("Гучність, тривалість і власні аудіофайли (WAV, MP3, FLAC, OGG)");
                        icon: Icons.volume;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        padding-top: 16px;

                        Image {
                            source: Icons.volume;
                            width: 24px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            colorize: Theme.on-surface-variant;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            value: AppState.settings.volume;
                            value-label: round(AppState.settings.volume * 100) + "%";
                            changed(value) => {
                                AppState.settings.volume = value;
                                AppState.settings-changed();
                            }
                        }
                        Text {
                            min-width: 48px;
                            text: round(AppState.settings.volume * 100) + "%";
                            color: Theme.on-surface;
                            font-size: Type.title-medium;
                            font-weight: Type.emphasized;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    SettingRow {
                        title: @tr("Тривалість шкільного дзвінка");

                        Stepper {
                            value: AppState.settings.bell-seconds;
                            minimum: 1;
                            maximum: 60;
                            suffix: @tr("с");
                            changed(value) => {
                                AppState.settings.bell-seconds = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    SettingRow {
                        title: @tr("Тривалість сирени");

                        Stepper {
                            value: AppState.settings.siren-seconds;
                            minimum: 5;
                            maximum: 300;
                            step: 5;
                            suffix: @tr("с");
                            changed(value) => {
                                AppState.settings.siren-seconds = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                    Divider { }

                    Rectangle { height: 4px; }

                    SoundFileRow {
                        label: @tr("Файл шкільного дзвінка");
                        path: AppState.settings.bell-file;
                        sound: 0;
                        edited(text) => {
                            AppState.settings.bell-file = text;
                            AppState.settings-changed();
                        }
                    }
                    SoundFileRow {
                        label: @tr("Файл сирени");
                        path: AppState.settings.siren-file;
                        sound: 1;
                        edited(text) => {
                            AppState.settings.siren-file = text;
                            AppState.settings-changed();
                        }
                    }
                    SoundFileRow {
                        label: @tr("Файл сигналу відбою");
                        path: AppState.settings.all-clear-file;
                        sound: 2;
                        edited(text) => {
                            AppState.settings.all-clear-file = text;
                            AppState.settings-changed();
                        }
                    }
                }
            }

            // Робота у фоні.
            Card {
                kind: CardKind.filled;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    SectionHeader {
                        text: @tr("Робота у фоні");
                        subtitle: @tr("Що робити, коли закривають вікно");
                        icon: Icons.school;
                    }

                    SettingRow {
                        title: @tr("Згортати в трей");
                        description: @tr("Після закриття вікна програма лишається в системному треї і далі подає дзвінки та сирену. Вийти — через меню значка в треї");

                        Switch {
                            checked: AppState.settings.close-to-tray;
                            toggled(value) => {
                                AppState.settings.close-to-tray = value;
                                AppState.settings-changed();
                            }
                        }
                    }
                }
            }

            // Оформлення.
            Card {
                kind: CardKind.filled;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    SectionHeader {
                        text: @tr("Оформлення");
                        subtitle: @tr("Тема і мова застосовуються одразу");
                        icon: Icons.dark-mode;
                    }
                    HorizontalLayout {
                        alignment: start;

                        ButtonGroup {
                            items: [
                                { label: @tr("Як у системі"), icon: Icons.auto-mode },
                                { label: @tr("Світла"), icon: Icons.light-mode },
                                { label: @tr("Темна"), icon: Icons.dark-mode },
                            ];
                            selected: AppState.settings.theme;
                            selected-changed(index) => {
                                AppState.settings.theme = index;
                                AppState.theme-changed(index);
                            }
                        }
                    }
                    Text {
                        text: @tr("Мова інтерфейсу");
                        color: Theme.on-surface-variant;
                        font-size: Type.label-large;
                        font-weight: Type.medium;
                    }
                    HorizontalLayout {
                        alignment: start;

                        ButtonGroup {
                            // Назви мов — кожна своєю мовою, без перекладу.
                            items: [
                                { label: @tr("Як у системі"), icon: Icons.auto-mode },
                                { label: "Українська" },
                                { label: "English" },
                            ];
                            selected: AppState.settings.language;
                            selected-changed(index) => {
                                AppState.settings.language = index;
                                AppState.language-changed(index);
                            }
                        }
                    }
                    Text {
                        text: @tr("Файл налаштувань: {}", AppState.config-path);
                        color: Theme.on-surface-variant;
                        font-size: Type.body-small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // Панель збереження.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: AppState.settings-dirty ? root.height - self.height - 24px : root.height + 8px;
        width: min(root.width - 32px, 560px);
        height: bar-layout.preferred-height;
        border-radius: Shape.extra-large;
        background: Theme.surface-container-highest;
        drop-shadow-color: Theme.shadow.with-alpha(0.25);
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        animate y { duration: Motion.default; easing: Motion.spatial; }

        bar-layout := HorizontalLayout {
            padding: 12px;
            padding-left: 24px;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: @tr("Є незбережені зміни");
                color: Theme.on-surface;
                font-size: Type.body-large;
                font-weight: Type.medium;
                vertical-alignment: center;
            }
            Button {
                text: @tr("Зберегти");
                icon: Icons.save;
                clicked => { AppState.save-settings(); }
            }
        }
    }
}
