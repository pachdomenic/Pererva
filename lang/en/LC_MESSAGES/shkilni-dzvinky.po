msgstr "The nationwide minute of silence is at 09:00"

msgid "ГГ:ХХ"
msgstr "HH:MM"

msgid "Лише в навчальні дні"
msgstr "School days only"

msgid "Інакше — щодня, включно з вихідними"
msgstr "Otherwise every day, weekends included"

msgid "Гімн після хвилини мовчання"
msgstr "Anthem after the minute of silence"

msgid "Вкажіть файл гімну нижче, інакше гімн не прозвучить"
msgstr "Choose the anthem file below, otherwise the anthem won't play"

msgid "Звучить одразу після хвилини мовчання"
msgstr "Plays right after the minute of silence"

msgid "Доріжка хвилини мовчання"
msgstr "Minute of silence track"

msgid "Доріжка гімну"
msgstr "Anthem track"

msgid "Файл не вибрано"
msgstr "No file selected"

msgid "Звук"
msgstr "Sound"

msgid "Гучність, тривалість і власні аудіофайли (WAV, MP3, FLAC, OGG)"
msgstr "Volume, duration and custom audio files (WAV, MP3, FLAC, OGG)"

msgid "Тривалість шкільного дзвінка"
msgstr "School bell duration"

msgid "Тривалість сирени"
msgstr "Siren duration"

msgid "Файл шкільного дзвінка"
msgstr "School bell file"

msgid "Файл сирени"
msgstr "Siren file"

