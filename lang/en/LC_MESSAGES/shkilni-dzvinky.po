msgstr "Treat a partial alert as an alert"

msgid "Реагувати, якщо тривогу оголошено лише в частині громад області чи району"
msgstr "React when an alert covers only some communities of the region or district"

msgid "Тривога жовтого рівня"
msgstr "Yellow-level alert"

msgid "Лише показується на головній: без сирени, дзвінки подаються"
msgstr "Only shown on the home page: no siren, bells keep ringing"

msgid "Як тривога червоного рівня: та сама сирена і той самий відбій"
msgstr "Like a red-level alert: the same siren and the same all clear"

msgid "Як тривога червоного рівня, але з власними сигналами початку і відбою"
msgstr "Like a red-level alert, but with its own start and all-clear signals"

msgid "Не реагувати"
msgstr "Ignore"

msgid "Як червоного рівня"
msgstr "Same as red"

msgid "Окремі звуки"
